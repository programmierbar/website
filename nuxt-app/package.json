{
    "name": "nuxt-app",
    "version": "0.0.0",
    "private": true,
    "engines": {
        "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "eslint": "eslint --fix .",
        "lint": "eslint .",
        "prettier": "prettier . --write",
        "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.json",
        "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:smoke": "playwright test",
        "test:smoke:install": "playwright install --with-deps chromium"
    },
    "dependencies": {
        "@directus/sdk": "^21.3.0",
        "@google/generative-ai": "^0.24.1",
        "@nuxtjs/tailwindcss": "^6.11.4",
        "@pinia/nuxt": "^0.5.1",
        "@types/google.maps": "^3.55.3",
        "@ubclaunchpad/vue-fathom": "^2.0.0",
        "h3-zod": "^0.5.3",
        "html5-qrcode": "^2.3.8",
        "isomorphic-dompurify": "~2.20.0",
        "nodemailer": "^9.0.3",
        "nuxt-jsonld": "^2.0.8",
        "pinia": "^2.1.7",
        "rss": "^1.2.2",
        "stripe": "^20.3.0",
        "vite-svg-loader": "^5.1.0",
        "vue-json-pretty": "^2.5.0",
        "web-haptics": "^0.0.6",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.1.1",
        "@nuxt/eslint-config": "^0.2.0",
        "@nuxt/image": "^2.1.0",
        "@nuxtjs/algolia": "^1.11.2",
        "@playwright/test": "^1.62.1",
        "@types/nodemailer": "^8.0.1",
        "@types/rss": "^0.0.32",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-nuxt": "^4.0.0",
        "eslint-plugin-vue": "^9.21.1",
        "nuxt": "^4.5.1",
        "postcss": "^8.4.35",
        "prettier": "^3.2.5",
        "prettier-plugin-tailwindcss": "^0.5.11",
        "typescript": "^6.0.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.9"
    },
    "overrides": {
        "vue": "^3.5.0",
        "minimatch": "^9.0.7",
        "typescript": "^6.0.3"
    }
}
